{
    "name": "drizzle-rest",
    "version": "0.1.2-alpha.3",
    "description": "A dynamic REST API adapter for Drizzle ORM with JSON-Server compatible query syntax",
    "type": "module",
    "scripts": {
        "build": "pnpm --filter @drizzle-rest/* build",
        "test": "pnpm --filter @drizzle-rest/* test",
        "lint:fix": "eslint . --fix",
        "lint": "eslint .",
        "deps:graph": "depcruise --no-config --output-type mermaid --exclude 'node_modules|dist' packages > dependencies.mmd",
        "deps:graph:core": "depcruise --no-config --output-type mermaid --exclude 'node_modules|dist' packages/core > dependencies-core.mmd"
    },
    "author": "Marian Gaebler <marian.gaebler@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/mgaebler/drizzle-rest.git"
    },
    "bugs": {
        "url": "https://github.com/mgaebler/drizzle-rest/issues"
    },
    "homepage": "https://github.com/mgaebler/drizzle-rest#readme",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "dependencies": {
        "@electric-sql/pglite": "^0.3.4",
        "drizzle-orm": "^0.44.2",
        "drizzle-seed": "^0.3.1",
        "drizzle-zod": "^0.5.1",
        "express": "^4.18.2",
        "pino": "^9.7.0",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.1.0",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.5",
        "@types/pino": "^7.0.5",
        "@types/supertest": "^6.0.0",
        "dependency-cruiser": "^17.0.0",
        "drizzle-kit": "^0.31.4",
        "eslint": "^9.31.0",
        "eslint-plugin-drizzle": "^0.2.3",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.1.4",
        "globals": "^16.3.0",
        "husky": "^9.1.7",
        "jiti": "^2.4.2",
        "pino-pretty": "^13.0.0",
        "supertest": "^6.3.4",
        "ts-unused-exports": "^11.0.1",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.36.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.4"
    },
    "workspaces": [
        "packages/*",
        "examples/*"
    ]
}