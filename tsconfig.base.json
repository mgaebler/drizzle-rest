{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "declaration": true,
        "isolatedModules": true,
        "strict": true,
        "skipLibCheck": true
    }
}
