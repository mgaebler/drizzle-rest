{
    "name": "@drizzle-rest/core",
    "version": "0.1.0",
    "type": "module",
    "main": "dist/index.js",
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "build:check": "npm run lint && npm run test && npm run build",
        "test": "vitest --run",
        "lint": "eslint . --ext .ts",
        "package:verify": "npm pack --dry-run",
        "prepublishOnly": "npm run test && npm run lint",
        "security:check": "npm audit --audit-level=high || true",
        "prerelease": "npm run build:check && npm run security:check",
        "release:alpha": "npm version prerelease --preid=alpha && npm publish --tag alpha --access public",
        "release:beta": "npm version prerelease --preid=beta && npm publish --tag beta --access public",
        "release:major": "npm version major && npm publish --access public",
        "release:minor": "npm version minor && npm publish --access public",
        "release:patch": "npm version patch && npm publish --access public"
    },
    "peerDependencies": {
        "drizzle-orm": "^0.44.0",
        "drizzle-zod": "^0.5.0",
        "zod": "^3.22.0",
        "pino": "^9.8.0"
    },
    "devDependencies": {
        "drizzle-orm": "^0.44.0",
        "drizzle-zod": "^0.5.0",
        "zod": "^3.22.0",
        "pino": "^9.8.0"
    },
    "keywords": [
        "drizzle",
        "drizzle-orm",
        "rest",
        "api",
        "json-server",
        "typescript",
        "express",
        "crud",
        "adapter",
        "database",
        "postgresql"
    ],
    "author": "Marian Gaebler <marian.gaebler@gmail.com>",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    }
}